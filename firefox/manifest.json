{
  "manifest_version": 3,
  "name": "Tabitha",
  "version": "0.1.2",
  "description": "Safari-style workspaces. Switch a workspace to hide one set of tabs and show another. Nothing closes, nothing reloads.",
  "permissions": [
    "tabs",
    "tabHide",
    "storage"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "tabitha@jevawin",
      "strict_min_version": "115.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tabitha",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": [
      "core.js",
      "background.js"
    ]
  }
}
