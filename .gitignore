.DS_Store

# Local visual test harness for the popup (stubs chrome.* with sample data)
/test/harness.html

# Synced copies of shared/ — written by `node tools/sync.mjs`, never edited by
# hand. shared/ is the only source of truth.
chrome/popup.html
chrome/popup.css
chrome/popup.js
chrome/core.js
chrome/icon-data.json
chrome/icons/
firefox/popup.html
firefox/popup.css
firefox/popup.js
firefox/core.js
firefox/icon-data.json
firefox/icons/

# Packaged / AMO-signed builds. Rebuilt from source, never committed.
*.xpi
/web-ext-artifacts/
# web-ext's local upload cache (upload uuid + xpi hash, no credentials).
.amo-upload-uuid

# Credentials never belong in the repo. The real AMO file lives outside it, at
# ~/.config/tabitha/amo.env — these patterns are belt and braces.
.env
*.env

# Playwright MCP scratch output.
.playwright-mcp/
